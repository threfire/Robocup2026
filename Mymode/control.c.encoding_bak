//==================================================================
//锟?锟?鍚嶏細鍓嶅線鐩爣锟?//锟?   鑳斤細璁剧疆鐩爣鐐瑰苟浣胯兘杩愬姩锛岀劧鍚庡垽鏂槸鍚︾Щ鍔ㄥ畬锟?//杈撳叆鍙傛暟锛氱洰鏍噚锛寉鍧愭爣
//锟?锟?uint8_t target_set = 0;
uint8_t move_to_target(float x, float y) {


    if (!target_set) {
        SetTargetPosition(x, y);
        PositionControl_Enable(1);
        target_set = 1;
        return 0;
    }

    if (IsPositionReached(raceh)) {
        // 绉诲姩瀹屾垚
        stop();
        target_set = 0;
        return 1; // 绉诲姩瀹屾垚
    }

    return 0; // 绉诲姩锟?}
/***********Task1***************/

// 鍚姩浠诲姟1
void start_task1(void) {
    task1_state.active = 1;
    task1_state.current_step = 1;
    task1_state.completed = 0;
    task1_state.step_start = HAL_GetTick();
}

uint8_t is_hasgetcolor = 0;
// 闈為樆濉炰换鍔℃墽锟?void run_task1(void) {
    if (!task1_state.active) return;//鏈娇鑳戒换鍔″垯杩斿洖
    uint32_t current_time = HAL_GetTick();
    switch (task1_state.current_step) {
//		case 0:	SetTargetYaw(0.0f);
//				Servo_Action_Group(1);pospid_reinit(LOWSPEED);
//				if (move_to_target(task1_targets[20].x, task1_targets[20].y)/*锟?*/) {task1_state.current_step++;}
//				if(IsPositionReached(0.10f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 2060);}
////				if(IsPositionReached(0.05f)){SetTargetPosition(task1_targets[0].x, task1_targets[0].y);task1_state.current_step++;}
//				break;
        case 1:	SetTargetYaw(0.0f);Move_to_turnplate(1);
				Servo_Action_Group(1);
				tasknum = 1;
				pospid_reinit(LOWSPEED);
				if (move_to_pose_target(task1_targets[0].x, task1_targets[0].y, 0.0f)/*鐐逛簩缁寸爜*/) {Servo_Action_Group(2);task1_state.current_step++;}
				if(IsPositionReached(0.50f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 2060);}
				if(IsPositionReached(0.45f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1980);}if(IsPositionReached(0.40f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1930);}
				if(IsPositionReached(0.35f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1900);}if(IsPositionReached(0.30f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1880);}
				if(IsPositionReached(0.25f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1860);}if(IsPositionReached(0.20f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1840);}
				if(IsPositionReached(0.15f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1820);}if(IsPositionReached(0.10f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1810);}
				if(IsPositionReached(0.04f)){__HAL_TIM_SetCompare(&htim14, TIM_CHANNEL_1, 1800);}
				break;
        case 2:Servo_Action_Group(2);PositionControl_Enable(0);
				SetTargetVelocity(1.0f, 0.0f, -2.47f);
				HAL_Delay(500);
				Move_to_turnplate(2);
				HAL_Delay(1000);
				Get_Materialcolor(0);
				Move_to_turnplate(3);
				HAL_Delay(450);
				SetTargetVelocity(1.0f, 0.0f, -2.08f);
				HAL_Delay(500);
				Get_Materialcolor(1);
				Move_to_turnplate(4);
				HAL_Delay(500);
				SetTargetVelocity(1.0f, 0.0f, -2.14f);
				HAL_Delay(550);
				Get_Materialcolor(2);
				Move_to_turnplate(5);
				HAL_Delay(1000);Get_Materialcolor(3);__HAL_TIM_SetCompare(&htim11, TIM_CHANNEL_1, Material[3]+200);
				stop();
				task1_state.current_step =11;
				break;


		case 11:pospid_reinit(MIDSPEED);SetTargetYaw(-90.0f);Get_Materialcolor(4);
				if (move_to_pose_target(task1_targets[6].x, task1_targets[6].y, -90.0f)/*绉诲埌鐐筧*/ ) {
										Find_corresponding_material(1);
										task1_state.current_step++;}break;
		case 12:if(Wait_for_uart_with_search(6) != UART_SEARCH_RESULT_RUNNING) { task1_state.current_step++; } break;
		case 13:if(CamStabilizationToCenter(TOLERANCE,TOLERANCE,max_min_error)){POS_move();task1_state.current_step++;}break;
		case 14:pospid_reinit(HIGHSPEED);if (move_to_pose_target(task1_targets[7].x, task1_targets[7].y, -90.0f)/*绉诲埌鐐筨*/) {
					Find_corresponding_material(2);
					task1_state.current_step++;}break;
		case 15:if(Wait_for_uart_with_search(7) != UART_SEARCH_RESULT_RUNNING) { task1_state.current_step++; } break;
		case 16:if(CamStabilizationToCenter(TOLERANCE,TOLERANCE,max_min_error)){
						POS_move();task1_state.current_step++;}break;
		case 17:if (move_to_pose_target(task1_targets[8].x, task1_targets[8].y, -90.0f)) {
					Find_corresponding_material(3);
					task1_state.current_step++;}break;
		case 18:if(Wait_for_uart_with_search(8) != UART_SEARCH_RESULT_RUNNING) { task1_state.current_step++; } break;
		case 19:if(CamStabilizationToCenter(TOLERANCE,TOLERANCE,max_min_error)){
						POS_move();task1_state.current_step++;}break;
		case 20:if (move_to_pose_target(task1_targets[9].x, task1_targets[9].y, -90.0f)) {
					Find_corresponding_material(4);
					task1_state.current_step++;}break;
		case 21:if(Wait_for_uart_with_search(9) != UART_SEARCH_RESULT_RUNNING) { task1_state.current_step++; } break;
		case 22:if(CamStabilizationToCenter(TOLERANCE,TOLERANCE,max_min_error)){
						POS_move();task1_state.current_step++;}break;
		case 23:if (move_to_pose_target(task1_targets[10].x, task1_targets[10].y, -90.0f)) {
					Find_corresponding_material(5);
					task1_state.current_step++;}break;
		case 24:if(Wait_for_uart_with_search(10) != UART_SEARCH_RESULT_RUNNING) { task1_state.current_step++; } break;
		case 25:if(CamStabilizationToCenter(TOLERANCE,TOLERANCE,max_min_error)){
						POS_move();task1_state.current_step++;}break;
		case 26://Servo_Action_Group(2);SetTargetYaw(0.0f);
				tasknum = 2;if (move_to_pose_target(task1_targets[11].x, task1_targets[11].y, 0.0f)/*鐐逛簩缁寸爜2*/) {Move_to_turnplate(3);/*绉诲埌杞洏1*/task1_state.current_step++;}break;
		case 27:if (move_to_pose_target(task1_targets[19].x, task1_targets[19].y, -90.0f)/*濂栨澂3涓嬮潰*/){task1_state.current_step++;}break;
		case 28:pospid_reinit(LOWESTSPEED);if (move_to_pose_target(task1_targets[12].x, task1_targets[12].y, -90.0f)/*濂栨澂3*/){task1_state.current_step++;Move_to_turnplate(2);}break;
		case 29:if (move_to_pose_target(task1_targets[13].x, task1_targets[13].y, -90.0f)/*濂栨澂2*/) {task1_state.current_step++;Move_to_turnplate(1);}break;
		case 30:if (move_to_pose_target(task1_targets[14].x, task1_targets[14].y, -90.0f)/*濂栨澂1*/) {__HAL_TIM_SetCompare(&htim11, TIM_CHANNEL_1, Material[1]+200);task1_state.current_step++;}	break;
		case 31:
				pospid_reinit(HIGHSPEED);
				if (move_to_pose_target(task1_targets[15].x, task1_targets[15].y+15.0f, -90.0f)/*浜氬啗锟?/) {Servo_Action_Group(6);Find_corresponding_material(2);task1_state.current_step++;break;}
				if(IsPositionReached(0.6f)){Servo_Action_Group(5);}break;
		case 32:if(Wait_for_uart_with_search(15) != UART_SEARCH_RESULT_RUNNING) { task1_state.current_step++; } break;
		case 33:if(CamStabilizationToCenter(TOLERANCE,TOLERANCE,max_min_error)){
						POS_move();Servo_Action_Group(3);HAL_Delay(100);
						task1_state.current_step++;}break;
		case 34:if (move_to_pose_target(task1_targets[16].x, task1_targets[16].y+15.0f, -90.0f)/*鍐犲啗锟?/) {Servo_Action_Group(4);Find_corresponding_material(1);task1_state.current_step++;}break;
		case 35:if(Wait_for_uart_with_search(16) != UART_SEARCH_RESULT_RUNNING) { task1_state.current_step++; } break;
		case 36:if(CamStabilizationToCenter(TOLERANCE,TOLERANCE,max_min_error)){
						POS_move();Servo_Action_Group(3);
						task1_state.current_step++;}break;
		case 37:if (move_to_pose_target(task1_targets[17].x, task1_targets[17].y+25.0f, -90.0f)) {Servo_Action_Group(7);Find_corresponding_material(3);task1_state.current_step++;}break;
		case 38:if(Wait_for_uart_with_search(17) != UART_SEARCH_RESULT_RUNNING) { task1_state.current_step++; } break;
		case 39:if(CamStabilizationToCenter(TOLERANCE,TOLERANCE,max_min_error)){
						POS_move();task1_state.current_step++;}break;
		case 40:pospid_reinit(HIGHESTSPEED);raceh = 0.200f;
				if (move_to_pose_target(task1_targets[20].x, task1_targets[20].y, 0.0f)/*鍥炲*/) {task1_state.current_step = 41;}break;
		case 41:raceh = 0.020f;if (move_to_pose_target(task1_targets[18].x, task1_targets[18].y, 0.0f)/*鍥炲*/) {task1_state.current_step++;}break;
        default:
            task1_state.active = 0;
            task1_state.completed = 1;
            break;
    }
}
